{
    "name": "Crickso Chat Admin",
    "short_name": "Crickso Admin",
    "description": "Crickso live chat admin panel - reply to users, images and files, on the go.",
    "id": "/admin-chat/",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "portrait",
    "background_color": "#f1f5f9",
    "theme_color": "#2563eb",
    "lang": "en",
    "dir": "ltr",
    "categories": ["business", "productivity"],
    "icons": [
        {
            "src": "./icons/icon-32.png",
            "sizes": "32x32",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-192-maskable.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "./icons/icon-512-maskable.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Active chats",
            "short_name": "Active",
            "url": "./index.html?filter=active"
        }
    ]
}